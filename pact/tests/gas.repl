;; gas.repl — REPL table-model gas for attest and every read, with ceilings. Scored by EXIT CODE.
;; The REPL model is indicative only; devnet numbers are authoritative and recorded in
;; the README. Recipe: (env-gasmodel "table") (env-gaslimit N) (env-set-milligas 0) … (env-gas).
(load "harness.repl")
(defconst EPOCH (time "1970-01-01T00:00:00Z"))

(env-gasmodel "table")
(env-gaslimit 150000)

(env-chain-data { "chain-id": "2", "block-height": 1001, "prev-block-hash": "H1000"
                , "block-time": (add-time EPOCH 1000), "sender": "bot" })
(begin-tx)
(env-set-milligas 0)
(free.block-history.attest)
(let ((g (env-gas)))
  (print (format "gas attest (first record)      = {}" [g]))
  (expect "G1 attest under 1,000" true (< g 1000)))
(env-set-milligas 0)
(free.block-history.attest)
(let ((g (env-gas)))
  (print (format "gas attest (duplicate no-op)   = {}" [g]))
  (expect "G2 no-op cheaper than the record" true (< g 600)))
(env-set-milligas 0)
(free.block-history.get-attested 1000)
(print (format "gas get-attested               = {}" [(env-gas)]))
(env-set-milligas 0)
(free.block-history.hash-of 1000)
(print (format "gas hash-of                    = {}" [(env-gas)]))
(env-set-milligas 0)
(free.block-history.time-of 1000)
(print (format "gas time-of                    = {}" [(env-gas)]))
(env-set-milligas 0)
(free.block-history.has-attested 1000)
(print (format "gas has-attested               = {}" [(env-gas)]))
(env-set-milligas 0)
(free.block-history.latest)
(print (format "gas latest                     = {}" [(env-gas)]))
(env-set-milligas 0)
(free.block-history.chain)
(print (format "gas chain                      = {}" [(env-gas)]))
(env-set-milligas 0)
(free.block-history.key 1000)
(print (format "gas key                        = {}" [(env-gas)]))
(commit-tx)
(print "gas.repl: OK")
