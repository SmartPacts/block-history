;; block-history.repl — positive lifecycle in deployment order. Scored by EXIT CODE.
;; Every assertion names the requirement it pins.
(load "harness.repl")

(defconst EPOCH (time "1970-01-01T00:00:00Z"))

;; ---- P1 empty world: nothing is recorded until someone attests --------------------
(begin-tx)
(expect "P1 a block from before the first attest is absent" false (free.block-history.has-attested 999))
(expect "P1b latest is the empty sentinel" { "height": -1, "hash": "", "time": EPOCH }
  (free.block-history.latest))
(expect "P1c chain is the engine's chain-id" "2" (free.block-history.chain))
(commit-tx)

;; ---- P2 attest records exactly the previous block from engine values ------------
(env-chain-data { "chain-id": "2", "block-height": 1001, "prev-block-hash": "H1000"
                , "block-time": (add-time EPOCH 1000), "sender": "bot-a" })
(env-sigs [])
(begin-tx)
(expect "P2 an unsigned attest records" "recorded" (free.block-history.attest))
(expect "P2b the row is the engine's prev-block-hash, block-time and sender"
  { "hash": "H1000", "time": (add-time EPOCH 1000), "by": "bot-a" }
  (free.block-history.get-attested 1000))
(expect "P2c hash-of reads the attested hash" "H1000" (free.block-history.hash-of 1000))
(expect "P2d time-of reads the attested time" (add-time EPOCH 1000) (free.block-history.time-of 1000))
(expect "P2e has-attested" true (free.block-history.has-attested 1000))
(expect "P2f the current block is not recorded, only the previous one" false
  (free.block-history.has-attested 1001))
(expect "P2g latest advanced" { "height": 1000, "hash": "H1000", "time": (add-time EPOCH 1000) }
  (free.block-history.latest))
(expect "P2h the ATTESTED event carries the full record"
  [ { "name": "free.block-history.ATTESTED", "params": [1000 "H1000" (add-time EPOCH 1000) "bot-a"], "module-hash": (at 'hash (describe-module "free.block-history")) } ]
  (env-events true))
(commit-tx)

;; ---- P3 idempotent: a second recorder in the SAME block is a no-op, not an abort ---
(env-chain-data { "chain-id": "2", "block-height": 1001, "prev-block-hash": "H1000"
                , "block-time": (add-time EPOCH 1000), "sender": "bot-b" })
(begin-tx)
(expect "P3 duplicate in the same block is a cheap no-op" "already recorded" (free.block-history.attest))
(expect "P3b the first recorder's row is untouched" "bot-a" (at 'by (free.block-history.get-attested 1000)))
(expect "P3c no event on a no-op" [] (env-events true))
(commit-tx)

;; ---- P4 a missed block stays absent, and never blocks the next record ---------------
(env-chain-data { "chain-id": "2", "block-height": 1003, "prev-block-hash": "H1002"
                , "block-time": (add-time EPOCH 1002), "sender": "bot-a" })
(begin-tx)
(expect "P4 recording after a missed block still works" "recorded" (free.block-history.attest))
(expect "P4b the missed height stays absent" false (free.block-history.has-attested 1001))
(expect "P4c latest is the newest attested height" 1002 (at 'height (free.block-history.latest)))
(commit-tx)

;; ---- P5 the engine's time is stored exactly, to the microsecond --------------------
;; Off the harness convention on purpose: this block's time carries a fraction.
(env-chain-data { "chain-id": "2", "block-height": 1004, "prev-block-hash": "H1003"
                , "block-time": (add-time EPOCH 1003.123456), "sender": "bot-a" })
(begin-tx)
(expect "P5 record" "recorded" (free.block-history.attest))
(expect "P5b the microseconds survive" "1970-01-01T00:16:43.123456Z"
  (format-time "%Y-%m-%dT%H:%M:%S.%vZ" (free.block-history.time-of 1003)))
(commit-tx)

;; ---- P7 key shape ----------------------------------------------------------------
(begin-tx)
(expect "P7 keys are 12-wide zero-padded" "000000001010" (free.block-history.key 1010))
(expect "P7b height 0 pads fully" "000000000000" (free.block-history.key 0))
(expect "P7c the widest allowed height is unpadded" "999999999999" (free.block-history.key 999999999999))
(commit-tx)

;; ---- P8 chain is whichever chain the engine says it is -------------------------------
;; Every other test runs on chain "2"; relabelling it proves chain reads the engine.
(env-chain-data { "chain-id": "19" })
(begin-tx)
(expect "P8 chain follows the engine's chain-id" "19" (free.block-history.chain))
(commit-tx)
(env-chain-data { "chain-id": "2" })

(print "block-history.repl: OK")
