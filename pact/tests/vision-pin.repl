;; vision-pin.repl — the tests that go RED if the vision is violated. Scored by EXIT CODE.
;;
;; The vision: every row is the engine's own account of a block, written by the one
;; function that writes, which takes no arguments; a caller decides only WHETHER a row is
;; written, never what it says; a recorded height is final; an unrecorded height is
;; absent, never a default; latest is the newest record, whatever the deploy left in it;
;; the code can never change.
;; run.sh builds one mutant of the module per clause and requires this file to FAIL
;; against each, for the reason named beside it:
;;   caller-value   attest takes the hash from transaction data    VISION-1a: the caller's hash landed
;;   takes-arg      attest takes the hash as an argument           VISION-2: the call with an argument recorded
;;   rewrite        a second recording overwrites the first        VISION-3: the read-only probe hit a write
;;   abort-dup      a second recording aborts                      VISION-3: the probe caught an abort
;;   gov-open       governance can be satisfied                    VISION-4: module admin was granted
;;   second-writer  a read function also writes a row              VISION-5: the read-only probe hit a write
;;   gap-default    get-attested answers a gap with a default row  VISION-6a: the read of a gap returned a row
;;   latest-guard   attest writes latest only above the old one    VISION-7b: the planted latest survived
;; The upgrade half of VISION-4 is frozen.repl-must-fail; the static half of VISION-5 is
;; run.sh's DML inventory. run.sh checks both against the same mutants.
(load "harness.repl")
(defconst EPOCH (time "1970-01-01T00:00:00Z"))

;; Throughout this file the transaction data offers caller-chosen values under the names a
;; row has. None of them may ever land.
(env-data { "hash": "CALLER-HASH", "by": "caller", "height": 5 })

;; ---- VISION-1: a row is exactly what the engine handed attest --------------------
(env-chain-data { "chain-id": "2", "block-height": 1001, "prev-block-hash": "H1000"
                , "block-time": (add-time EPOCH 1000), "sender": "bot" })
(begin-tx)
(expect "VISION-1 attest records" "recorded" (free.block-history.attest))
(expect "VISION-1a the row is the engine's prev-block-hash, block-time and sender, at block-height - 1"
  { "hash": "H1000", "time": (add-time EPOCH 1000), "by": "bot" }
  (free.block-history.get-attested 1000))
(expect "VISION-1b latest holds the engine's values too"
  { "height": 1000, "hash": "H1000", "time": (add-time EPOCH 1000) }
  (free.block-history.latest))
(expect "VISION-1c the event carries the engine's values"
  [ [1000 "H1000" (add-time EPOCH 1000) "bot"] ]
  (map (at 'params) (env-events true)))
(expect "VISION-1d the caller-chosen height got nothing" false (free.block-history.has-attested 5))
(commit-tx)

;; ---- VISION-2: attest takes no arguments, so a caller cannot hand it a value -------
(begin-tx)
(expect-failure "VISION-2 attest refuses an argument" "Attempted to apply a closure to too many arguments"
  (free.block-history.attest "CALLER-HASH"))
(rollback-tx)

;; ---- VISION-3: a recorded height is final; a second recording is a pure no-op ------
;; The engine can never hand a different prev-block-hash for one height on one fork; this
;; hands one anyway, from a different sender. `try` runs attest read-only: the no-op must
;; return its answer without aborting (else `try` yields "ABORTED") and without writing
;; (a write in read-only mode is an error `try` does not catch, so the expectation fails).
(env-chain-data { "chain-id": "2", "block-height": 1001, "prev-block-hash": "FORGED-1000"
                , "block-time": (add-time EPOCH 1000), "sender": "mallory" })
(begin-tx)
(expect "VISION-3 a second recording returns, never aborts, never writes" "already recorded"
  (try "ABORTED" (free.block-history.attest)))
(expect "VISION-3a the first value stands" "H1000" (free.block-history.hash-of 1000))
(expect "VISION-3b the first recorder stands" "bot" (at 'by (free.block-history.get-attested 1000)))
(expect "VISION-3c no event" [] (env-events true))
(commit-tx)

;; ---- VISION-4: the code can never change ------------------------------------------
;; Module admin is what an upgrade and a direct table write both need; governance must
;; never grant it. (A plain external write is refused by the engine even with governance
;; open, so negatives.repl covers those; this pins the part only governance holds.)
(begin-tx)
(expect-failure "VISION-4 module admin can never be acquired" "block-history is immutable: it can never be upgraded"
  (acquire-module-admin free.block-history))
(rollback-tx)
(begin-tx)
(expect-failure "VISION-4a so nobody can acquire it and then rewrite a row" "block-history is immutable: it can never be upgraded"
  (let ((admin (acquire-module-admin free.block-history)))
    (write free.block-history.attested "000000001000" { "hash": "FORGED", "time": EPOCH, "by": "mallory" })))
(expect "VISION-4b the row stands" "H1000" (free.block-history.hash-of 1000))
(rollback-tx)

;; ---- VISION-5: attest is the only function that writes -----------------------------
;; `try` runs its body read-only, and a write there is an error it does not catch. Every
;; other public function runs inside one and must return its ordinary answer; a function
;; that writes fails its expectation instead.
(begin-tx)
(expect "VISION-5 get-attested writes nothing" { "hash": "H1000", "time": (add-time EPOCH 1000), "by": "bot" }
  (try "ABORTED" (free.block-history.get-attested 1000)))
(expect "VISION-5 hash-of writes nothing" "H1000" (try "ABORTED" (free.block-history.hash-of 1000)))
(expect "VISION-5 time-of writes nothing" (add-time EPOCH 1000) (try "ABORTED" (free.block-history.time-of 1000)))
(expect "VISION-5 has-attested writes nothing" true (try "ABORTED" (free.block-history.has-attested 1000)))
(expect "VISION-5 latest writes nothing" { "height": 1000, "hash": "H1000", "time": (add-time EPOCH 1000) }
  (try "ABORTED" (free.block-history.latest)))
(expect "VISION-5 chain writes nothing" "2" (try "ABORTED" (free.block-history.chain)))
(expect "VISION-5 key writes nothing" "000000001000" (try "ABORTED" (free.block-history.key 1000)))
(commit-tx)
;; Control: the probe does see a write. attest on a height not yet recorded is refused in it.
(env-chain-data { "chain-id": "2", "block-height": 1002, "prev-block-hash": "H1001"
                , "block-time": (add-time EPOCH 1001), "sender": "bot" })
(begin-tx)
(expect-failure "VISION-5 control: the read-only probe refuses attest's write" "Operation disallowed in read-only or sys-only mode"
  (try "ABORTED" (free.block-history.attest)))
(expect "VISION-5 control: and nothing landed" false (free.block-history.has-attested 1001))
(rollback-tx)

;; ---- VISION-6: an unrecorded height is absent, never a default ---------------------
;; A consumer must be able to tell a gap from a block: has-attested answers false, and
;; every other read aborts rather than invent a row. 1001 sits between two records; 999
;; is from before the first attest.
(env-chain-data { "chain-id": "2", "block-height": 1003, "prev-block-hash": "H1002"
                , "block-time": (add-time EPOCH 1002), "sender": "bot" })
(begin-tx)
(expect "VISION-6 setup: 1002 records, so 1001 is a gap between two records" "recorded"
  (free.block-history.attest))
(commit-tx)
(begin-tx)
(expect "VISION-6 has-attested is false for a gap" false (free.block-history.has-attested 1001))
(expect "VISION-6 has-attested is false before the first attest" false (free.block-history.has-attested 999))
(expect-failure "VISION-6a get-attested aborts on a gap" "No value found in table free.block-history_attested for key: 000000001001"
  (free.block-history.get-attested 1001))
(expect-failure "VISION-6a get-attested aborts before the first attest" "No value found in table free.block-history_attested for key: 000000000999"
  (free.block-history.get-attested 999))
(expect-failure "VISION-6b hash-of aborts on a gap" "No value found in table free.block-history_attested for key: 000000001001"
  (free.block-history.hash-of 1001))
(expect-failure "VISION-6c time-of aborts on a gap" "No value found in table free.block-history_attested for key: 000000001001"
  (free.block-history.time-of 1001))
(commit-tx)

;; ---- VISION-7: latest is the newest record, whatever the deploy left in it ---------
;; The transaction that deploys the module holds its module admin until it ends, so code
;; after the module form can write its tables. Here a fresh deploy plants a latest far
;; above the chain; the first honest record must replace it. Times after the load are
;; literal: once that transaction commits, this file's EPOCH no longer resolves.
(env-data { "ns": "fresh", "hash": "CALLER-HASH", "by": "caller", "height": 5 })
(begin-tx)
(define-namespace "fresh" test-ns.USER-GUARD test-ns.ADMIN-GUARD)
(commit-tx)
(env-chain-data { "chain-id": "2", "block-height": 2000, "prev-block-hash": "H1999"
                , "block-time": (add-time EPOCH 1999), "sender": "deployer" })
(begin-tx)
(load "../modules/block-history.pact")
(write fresh.block-history.latest-tbl "latest"
  { "height": 999999999999, "hash": "FORGED", "time": (time "1970-01-01T00:00:00Z") })
(commit-tx)
(env-data { "hash": "CALLER-HASH", "by": "caller", "height": 5 })
(env-chain-data { "chain-id": "2", "block-height": 2001, "prev-block-hash": "H2000"
                , "block-time": (add-time (time "1970-01-01T00:00:00Z") 2000), "sender": "bot" })
(begin-tx)
(expect "VISION-7 control: the deploy transaction did plant its latest"
  { "height": 999999999999, "hash": "FORGED", "time": (time "1970-01-01T00:00:00Z") }
  (fresh.block-history.latest))
(expect "VISION-7a the first honest record" "recorded" (fresh.block-history.attest))
(expect "VISION-7b latest is the engine's record, not the planted one"
  { "height": 2000, "hash": "H2000", "time": (add-time (time "1970-01-01T00:00:00Z") 2000) }
  (fresh.block-history.latest))
(commit-tx)

(print "vision-pin.repl: OK")
