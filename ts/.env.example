# Copy to ts/.env. Shell variables take precedence over this file.
BH_HOST=http://localhost:8095
BH_NETWORK_ID=recap-development
BH_NS=free                      # mainnet: free as well
BH_CHAINS=0-19
BH_GAS_PRICE=1e-8

# Key files (JSON {publicKey, secretKey}); created automatically on a devnet only.
BH_ADMIN_KEY=out/admin-key.json
BH_FEEDER_KEY=out/feeder-key.json
BH_BACKFILL_KEY=out/backfill-key.json
# Optional: a multi-key backfill keyset instead of the single backfill key.
# BH_BACKFILL_KEYSET={"keys":["<64-hex>","<64-hex>"],"pred":"keys-2"}

# Feeder
BH_ATTEST_GAS_LIMIT=400
BH_ATTEST_TTL=300
BH_MAX_INFLIGHT=4
BH_SAMPLE_POLL=25
# BH_LOG_FILE=out/feeder.jsonl
