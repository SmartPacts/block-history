# Copy to ts/.env. Shell variables take precedence over this file.
BH_HOST=http://localhost:8095
BH_NETWORK_ID=recap-development
# The namespace; mainnet uses free as well. Comments go on their own line: the loader keeps an
# end-of-line comment as part of the value.
BH_NS=free
BH_CHAINS=0-19
BH_GAS_PRICE=1e-8

# Key files (JSON {publicKey, secretKey}); created automatically on a devnet only.
BH_ADMIN_KEY=out/admin-key.json
BH_FEEDER_KEY=out/feeder-key.json

# Feeder
BH_ATTEST_GAS_LIMIT=400
BH_ATTEST_TTL=300
BH_MAX_INFLIGHT=4
BH_SAMPLE_POLL=25
# BH_LOG_FILE=out/feeder.jsonl

# Optional sending modes, both OFF by default (the header of src/feeder.ts explains them).
# Fan-out: every signed attest also goes to these hosts' /send, in parallel, never delaying the
# submit to BH_HOST. Bare https origins, each once, not BH_HOST, at most 5. No extra gas: a chain
# includes the same transaction once at most.
# BH_SUBMIT_HOSTS=https://api.chainweb-community.org,https://chainweb.chaddex.com
# Waiting attests: one extra attest per chain every N seconds (whole seconds, 2 to 60, ±20 %
# jitter), so that one is usually already waiting when a block arrives. Only the first attest in a
# block records; the others are no-ops that still pay gas, so a chain sends about
# 1 + blockTime/N attests per block instead of 1, and fees rise roughly in that proportion.
# BH_WAITING_INTERVAL=10
